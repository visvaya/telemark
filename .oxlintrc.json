{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "deny"
  },
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-param-reassign": ["error", { "props": true }],
    "prefer-const": "error",
    "no-var": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-array-sort": "error",
    "typescript/prefer-readonly": "error",
    // A new object per element is how state is updated here; the lists are short (6 findings on 2026-11-16).
    "oxc/no-map-spread": "off",
    // Re-export by name only: a module that re-exports everything hides what it exposes.
    "oxc/no-barrel-file": ["error", { "threshold": 0 }],

    "eqeqeq": "error",
    "max-depth": ["error", 4],
    "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["error", { "max": 120, "skipBlankLines": true, "skipComments": true }],
    "complexity": ["error", 30],
    "max-params": ["error", 7],
    "no-console": "error",
    "no-alert": "error",
    "no-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/throw-new-error": "error",

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-deprecated": "error",

    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-duplicates": "error",
    "import/no-namespace": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],

    // The automatic JSX runtime imports what it needs.
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/no-danger": "error",
    "react/jsx-no-script-url": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-array-index-key": "error",
    "react/jsx-no-literals": ["error", { "allowedStrings": ["-", "+"] }],
    // role="status" on a live line, role="group" on a set of buttons and role="img" on a drawn picture have no
    // fitting tag: <output> belongs to forms, <fieldset> needs a legend, an SVG or a canvas is not an <img>
    // (20 findings).
    "jsx-a11y/prefer-tag-over-role": "off",

    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-conditional-expect": "error",
    "vitest/no-identical-title": "error"
  },
  "overrides": [
    {
      // The simulation is a port: its routines keep the original's shape, so a change needs the golden traces.
      "files": ["src/sim/**"],
      "rules": {
        // Without `props`: a step copies the frame state and the routines write into that copy, as the original
        // writes its memory (pose.ts, jump-logic.ts).
        "no-param-reassign": "error",
        // landClean mirrors one routine of the original (complexity 37).
        "complexity": ["error", 40],
        // INV_LN2 in deterministic-math.ts is written out to the last digit the polynomial needs.
        "oxc/approx-constant": "off",
        // Fixed-size lookup tables in deterministic-math.ts, indexed by a constant or by a value the code has just bounded.
        "typescript/no-non-null-assertion": "off",
        // `?? 0` on fixed-length tuples in pose.ts and jump-logic.ts (16 findings); removing them is a change
        // of the port.
        "typescript/no-unnecessary-condition": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../audio/*",
                  "../game/*",
                  "../original/*",
                  "../render/*",
                  "../storage/*",
                  "../ui/*",
                  "react",
                  "react-dom"
                ],
                "message": "The simulation is self-contained: pass the value in from the caller instead of importing it."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          { "name": "Date", "message": "The simulation must not read the clock: count fixed steps of 1/70 s." },
          { "name": "performance", "message": "The simulation must not read the clock: count fixed steps of 1/70 s." },
          {
            "name": "window",
            "message": "The simulation must not depend on the browser: take the value as a parameter."
          },
          {
            "name": "document",
            "message": "The simulation must not depend on the browser: take the value as a parameter."
          },
          {
            "name": "navigator",
            "message": "The simulation must not depend on the browser: take the value as a parameter."
          }
        ],
        "no-restricted-properties": [
          "error",
          { "object": "Math", "property": "random", "message": "Use BorlandRandom: the simulation is seeded." },
          { "object": "Math", "property": "sin", "message": "Use detSin from deterministic-math.ts." },
          { "object": "Math", "property": "cos", "message": "Use detCos from deterministic-math.ts." },
          { "object": "Math", "property": "atan", "message": "Use detAtan from deterministic-math.ts." },
          { "object": "Math", "property": "exp", "message": "Use detExp from deterministic-math.ts." },
          {
            "object": "Math",
            "property": "tan",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "atan2",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "asin",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "acos",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "log",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "pow",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "sinh",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "cosh",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "tanh",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "cbrt",
            "message": "Engine results differ between devices; add a deterministic version."
          },
          {
            "object": "Math",
            "property": "hypot",
            "message": "Engine results differ between devices; add a deterministic version."
          }
        ]
      }
    },
    {
      // The deterministic functions themselves, and the tests that compare them with the engine's.
      "files": ["src/sim/**/*.test.ts", "src/sim/test-support/**", "src/sim/deterministic-math.ts"],
      "rules": {
        "no-restricted-properties": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mjs",
        "src/**/test-support/*.cases.ts",
        "e2e/**/*.spec.ts",
        "e2e/**/*.perf.ts"
      ],
      // A describe block or a browser journey is one function by nature (75 findings).
      "rules": {
        "max-lines-per-function": "off"
      }
    },
    {
      // Browser steps run one after another on purpose (151 awaits in loops); small helpers stay next to the
      // test that reads them (13 findings).
      "files": ["e2e/**"],
      "rules": {
        "no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      // The script tests run one case after another against the same server, worker or process (18 findings).
      "files": ["scripts/**/*.test.mjs"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      // Scripts are command-line tools and report on the console; tests print what they measured.
      "files": ["**/*.test.ts", "scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Plain JavaScript without type annotations: parsed JSON and process output are untyped there.
      "files": ["scripts/**"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      // Vite, Vitest, Playwright and knip read their configuration from the default export.
      "files": ["*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    "tools",
    "re-out",
    ".scratch",
    "playwright-report",
    "test-results",
    "playwright-report-perf",
    "test-results-perf",
    "e2e/.sim-harness",
    "e2e/.pwa-releases",
    "dist-single"
  ]
}
